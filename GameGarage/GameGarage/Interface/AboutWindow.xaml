<Window x:Class="GameGarage.Interface.AboutWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:GameGarage.Resources" Title="{loc:Loc AboutTitle}" SizeToContent="WidthAndHeight"
 MinWidth="420" MaxWidth="650" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
<StackPanel Margin="24">
 <StackPanel Orientation="Horizontal"><Image Source="/GameGarage;component/Resources/KindComputersIcon.ico" Width="40" Height="40" Margin="0,0,12,0"/><TextBlock Text="{loc:Loc AppTitle}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
 <TextBlock Text="{loc:Loc AboutDescription}" TextWrapping="Wrap" Margin="0,16,0,8"/>
 <TextBlock Margin="0,0,0,16"><Hyperlink Click="Project_Click"><Run Text="{loc:Loc ProjectPage}"/></Hyperlink></TextBlock>
 <StackPanel Orientation="Horizontal"><TextBlock Text="{loc:Loc Version}" Margin="0,0,8,0"/><TextBlock Text="{Binding Version}"/></StackPanel>
 <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="{loc:Loc License}" Margin="0,0,8,0"/><TextBlock Text="{Binding License}"/></StackPanel>
 <TextBlock Text="{loc:Loc Copyright}" TextWrapping="Wrap" Margin="0,16,0,16"/>
 <Button Content="{loc:Loc Close}" HorizontalAlignment="Right" Padding="16,6" IsCancel="True" Click="Close_Click"/>
</StackPanel>
</Window>
