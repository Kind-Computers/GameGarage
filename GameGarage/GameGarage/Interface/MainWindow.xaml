<Window x:Class="GameGarage.Interface.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:GameGarage.Resources"
 Title="{loc:Loc AppTitle}" Width="850" Height="620" MinWidth="720" MinHeight="440"
 Icon="/GameGarage;component/Resources/KindComputersIcon.ico" Loaded="Window_Loaded" Closing="Window_Closing"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
 FontFamily="Segoe UI" FontSize="12">
<Window.Resources>
 <SolidColorBrush x:Key="CanvasBrush" Color="#19171C"/>
 <SolidColorBrush x:Key="PanelBrush" Color="#242128"/>
 <SolidColorBrush x:Key="TileBrush" Color="#2B2830"/>
 <SolidColorBrush x:Key="BorderBrush" Color="#4B424B"/>
 <SolidColorBrush x:Key="TextBrush" Color="#FFF2DC"/>
 <SolidColorBrush x:Key="MutedBrush" Color="#C9BCC3"/>
 <SolidColorBrush x:Key="AccentBrush" Color="#FFD278"/>
 <SolidColorBrush x:Key="ButtonInkBrush" Color="#30201D"/>
 <SolidColorBrush x:Key="ActiveBrush" Color="#4A352A"/>
 <SolidColorBrush x:Key="GoodBrush" Color="#253E32"/>
 <SolidColorBrush x:Key="ReviewBrush" Color="#493C29"/>
 <SolidColorBrush x:Key="IssueBrush" Color="#512D35"/>
 <SolidColorBrush x:Key="TrackBrush" Color="#19171C"/>
 <LinearGradientBrush x:Key="VerifyButtonBrush" StartPoint="0,0" EndPoint="1,1">
  <GradientStop Color="#FFE8AC" Offset="0"/><GradientStop Color="#FFC26C" Offset="0.55"/><GradientStop Color="#FF896D" Offset="1"/>
 </LinearGradientBrush>
 <Style x:Key="ToolCell" TargetType="Border">
  <Setter Property="Margin" Value="0,0,0,3"/><Setter Property="Padding" Value="9,4"/>
  <Setter Property="Background" Value="{DynamicResource TileBrush}"/>
 </Style>
 <Style TargetType="CheckBox">
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter>
  <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Trigger></Style.Triggers>
 </Style>
 <Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
 <Style TargetType="Button">
  <Setter Property="Padding" Value="12,7"/><Setter Property="MinWidth" Value="80"/>
  <Setter Property="Background" Value="{DynamicResource TileBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="ButtonFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonFrame" Property="BorderBrush" Value="{DynamicResource TextBrush}"/><Setter TargetName="ButtonFrame" Property="BorderThickness" Value="2"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonFrame" Property="Opacity" Value="0.8"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.72"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="VerifyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource VerifyButtonBrush}"/><Setter Property="Foreground" Value="{DynamicResource ButtonInkBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="FontSize" Value="17"/>
  <Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="20,13"/><Setter Property="MinWidth" Value="202"/>
 </Style>
 <Style TargetType="TabControl"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="0"/></Style>
 <Style TargetType="TabItem">
  <Setter Property="Background" Value="{DynamicResource TileBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  <Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,0,3,3"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
   <Border x:Name="TabFrame" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
    <ContentPresenter x:Name="TabHeader" ContentSource="Header" RecognizesAccessKey="True"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabFrame" Property="BorderBrush" Value="{DynamicResource TextBrush}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ProgressBar">
  <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="{DynamicResource TrackBrush}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
   <Grid x:Name="PART_Track" Background="{TemplateBinding Background}" ClipToBounds="True">
    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="LogList" TargetType="ListView">
  <Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/>
  <Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  <Setter Property="BorderThickness" Value="0"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
  <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True"/>
 </Style>
 <Style TargetType="ContextMenu"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
</Window.Resources>
<Window.TaskbarItemInfo><TaskbarItemInfo x:Name="TaskbarProgressBar" ProgressState="None"/></Window.TaskbarItemInfo>
<Grid Margin="16">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,12">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Margin="0,0,18,0">
   <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
    <Rectangle Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="0,0,4,0"/><Rectangle Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Opacity="0.65" Margin="0,0,4,0"/><Rectangle Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Opacity="0.35" Margin="0,0,9,0"/>
    <TextBlock x:Name="GuideEyebrow" Text="{loc:Loc GuideReadyBadge}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
   </StackPanel>
   <TextBlock x:Name="GuideHeadline" AutomationProperties.LiveSetting="Polite" Text="{loc:Loc GuideReadyTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
    <TextBlock x:Name="GuideDetail" Text="{loc:Loc GuideReadyDetail}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
   </ScrollViewer>
   <Button x:Name="GuideDetailsButton" Content="{loc:Loc GuideViewDetails}" Click="GuideDetailsButton_Click" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed"/>
  </StackPanel>
  <StackPanel Grid.Column="1" VerticalAlignment="Center">
   <Grid>
    <Button x:Name="StartTuneUpButton" Content="{loc:Loc RunSelected}" Style="{StaticResource VerifyButton}" Click="StartTuneUpButton_Click" AutomationProperties.Name="{loc:Loc VerifyActionName}"/>
    <Canvas x:Name="VerificationEffectLayer" IsHitTestVisible="False" Focusable="False"/>
   </Grid>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
    <Button x:Name="CancelTuneUpButton" Content="{loc:Loc Cancel}" Click="CancelTuneUpButton_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
    <Button Content="{loc:Loc Help}" Click="HelpHyperlink_Click"/>
   </StackPanel>
  </StackPanel>
 </Grid>
 <ProgressBar x:Name="SessionProgress" Grid.Row="1" Minimum="0" Maximum="100" Height="4" Margin="0,14,0,0" AutomationProperties.Name="{loc:Loc SessionProgressName}"/>
 </Grid>
</Border>

<TabControl x:Name="DashboardTabs" Grid.Row="1">
 <TabItem Header="{loc:Loc Overview}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
 <TextBlock Text="{loc:Loc Tagline}" TextWrapping="Wrap" Margin="0,0,0,12"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock Grid.Column="0" Text="{loc:Loc Tool}" FontWeight="SemiBold" Margin="10,0,0,8"/><TextBlock Grid.Column="1" Text="{loc:Loc Status}" FontWeight="SemiBold" Margin="10,0,0,8"/><TextBlock Grid.Column="2" Text="{loc:Loc Progress}" FontWeight="SemiBold" Margin="10,0,0,8"/>
 <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ToolCell}"><CheckBox x:Name="VerifyStabilityCheckBox" Content="{loc:Loc Stability}" IsChecked="True" VerticalAlignment="Center" /></Border>
<Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ToolCell}"><Label x:Name="VerifyStabilityLabel" Content="{loc:Loc Ready}" VerticalAlignment="Center" /></Border>
<Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ToolCell}"><ProgressBar x:Name="VerifyStabilityProgressBar" Minimum="0" Maximum="100" Height="8" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc Stability}" /></Border>
<Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ToolCell}"><CheckBox x:Name="VerifyDrivesCheckBox" Content="{loc:Loc Drives}" IsChecked="True" VerticalAlignment="Center" /></Border>
<Border Grid.Row="2" Grid.Column="1" Style="{StaticResource ToolCell}"><Label x:Name="VerifyDrivesLabel" Content="{loc:Loc Ready}" VerticalAlignment="Center" /></Border>
<Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ToolCell}"><ProgressBar x:Name="VerifyDrivesProgressBar" Minimum="0" Maximum="100" Height="8" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc Drives}" /></Border>
<Border Grid.Row="3" Grid.Column="0" Style="{StaticResource ToolCell}"><CheckBox x:Name="VerifyWindowsArchiveCheckBox" Content="{loc:Loc WindowsImage}" IsChecked="True" VerticalAlignment="Center" /></Border>
<Border Grid.Row="3" Grid.Column="1" Style="{StaticResource ToolCell}"><Label x:Name="VerifyWindowsArchiveLabel" Content="{loc:Loc Ready}" VerticalAlignment="Center" /></Border>
<Border Grid.Row="3" Grid.Column="2" Style="{StaticResource ToolCell}"><ProgressBar x:Name="VerifyWindowsArchiveProgressBar" Minimum="0" Maximum="100" Height="8" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc WindowsImage}" /></Border>
<Border Grid.Row="4" Grid.Column="0" Style="{StaticResource ToolCell}"><CheckBox x:Name="VerifyWindowsFilesCheckBox" Content="{loc:Loc WindowsFiles}" IsChecked="True" VerticalAlignment="Center" /></Border>
<Border Grid.Row="4" Grid.Column="1" Style="{StaticResource ToolCell}"><Label x:Name="VerifyWindowsFilesLabel" Content="{loc:Loc Ready}" VerticalAlignment="Center" /></Border>
<Border Grid.Row="4" Grid.Column="2" Style="{StaticResource ToolCell}"><ProgressBar x:Name="VerifyWindowsFilesProgressBar" Minimum="0" Maximum="100" Height="8" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc WindowsFiles}" /></Border>
<Border Grid.Row="5" Grid.Column="0" Style="{StaticResource ToolCell}"><CheckBox x:Name="VerifyDeviceDriversCheckBox" Content="{loc:Loc Drivers}" IsChecked="True" VerticalAlignment="Center" /></Border>
<Border Grid.Row="5" Grid.Column="1" Style="{StaticResource ToolCell}"><Label x:Name="VerifyDeviceDriversLabel" Content="{loc:Loc Ready}" VerticalAlignment="Center" /></Border>
<Border Grid.Row="5" Grid.Column="2" Style="{StaticResource ToolCell}"><ProgressBar x:Name="VerifyDeviceDriversProgressBar" Minimum="0" Maximum="100" Height="8" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc Drivers}" /></Border>
<Border Grid.Row="6" Grid.Column="0" Style="{StaticResource ToolCell}"><CheckBox x:Name="OptimizeDrivesCheckBox" Content="{loc:Loc Optimize}" IsChecked="True" VerticalAlignment="Center" /></Border>
<Border Grid.Row="6" Grid.Column="1" Style="{StaticResource ToolCell}"><Label x:Name="OptimizeDrivesLabel" Content="{loc:Loc Ready}" VerticalAlignment="Center" /></Border>
<Border Grid.Row="6" Grid.Column="2" Style="{StaticResource ToolCell}"><ProgressBar x:Name="OptimizeDrivesProgressBar" Minimum="0" Maximum="100" Height="8" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc Optimize}" /></Border>
 </Grid>
 <Border x:Name="StabilityTestNotification" Visibility="Collapsed" Padding="10" Background="{DynamicResource ReviewBrush}" Margin="0,8,0,0"><TextBlock Text="{loc:Loc RamNotice}" TextWrapping="Wrap"/></Border>
 <TextBlock Text="{loc:Loc MaintenanceNotice}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
 </StackPanel></ScrollViewer></TabItem>
 <TabItem x:Name="VerifyStabilityLogHeader" Header="{loc:Loc RamTab}"><TabControl>
<TabItem x:Name="VerifyStabilityScanLogHeader" Header="{loc:Loc Scan}"><ListView x:Name="VerifyStabilityScanLogListView" Style="{StaticResource LogList}" SelectionMode="Single" KeyDown="LogListView_KeyDown" ><ListView.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc CopyLine}" Click="LogListView_CopyLine_Click"/><MenuItem Header="{loc:Loc CopyAll}" Click="LogListView_CopyAll_Click"/></ContextMenu></ListView.ContextMenu></ListView></TabItem>

</TabControl></TabItem>
<TabItem x:Name="VerifyDrivesLogHeader" Header="{loc:Loc DrivesTab}"><TabControl>
<TabItem x:Name="VerifyDrivesScanLogHeader" Header="{loc:Loc Scan}"><ListView x:Name="VerifyDrivesScanLogListView" Style="{StaticResource LogList}" SelectionMode="Single" KeyDown="LogListView_KeyDown" ><ListView.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc CopyLine}" Click="LogListView_CopyLine_Click"/><MenuItem Header="{loc:Loc CopyAll}" Click="LogListView_CopyAll_Click"/></ContextMenu></ListView.ContextMenu></ListView></TabItem>
<TabItem x:Name="VerifyDrivesRepairLogHeader" Header="{loc:Loc Repair}"><ListView x:Name="VerifyDrivesRepairLogListView" Style="{StaticResource LogList}" SelectionMode="Single" KeyDown="LogListView_KeyDown" ><ListView.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc CopyLine}" Click="LogListView_CopyLine_Click"/><MenuItem Header="{loc:Loc CopyAll}" Click="LogListView_CopyAll_Click"/></ContextMenu></ListView.ContextMenu></ListView></TabItem>
</TabControl></TabItem>
<TabItem x:Name="VerifyWindowsArchiveLogHeader" Header="{loc:Loc ImageTab}"><TabControl>
<TabItem x:Name="VerifyWindowsArchiveScanLogHeader" Header="{loc:Loc Scan}"><ListView x:Name="VerifyWindowsArchiveScanLogListView" Style="{StaticResource LogList}" SelectionMode="Single" KeyDown="LogListView_KeyDown" ><ListView.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc CopyLine}" Click="LogListView_CopyLine_Click"/><MenuItem Header="{loc:Loc CopyAll}" Click="LogListView_CopyAll_Click"/></ContextMenu></ListView.ContextMenu></ListView></TabItem>
<TabItem x:Name="VerifyWindowsArchiveRepairLogHeader" Header="{loc:Loc Repair}"><ListView x:Name="VerifyWindowsArchiveRepairLogListView" Style="{StaticResource LogList}" SelectionMode="Single" KeyDown="LogListView_KeyDown" ><ListView.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc CopyLine}" Click="LogListView_CopyLine_Click"/><MenuItem Header="{loc:Loc CopyAll}" Click="LogListView_CopyAll_Click"/></ContextMenu></ListView.ContextMenu></ListView></TabItem>
</TabControl></TabItem>
<TabItem x:Name="VerifyWindowsFilesLogHeader" Header="{loc:Loc FilesTab}"><TabControl>
<TabItem x:Name="VerifyWindowsFilesScanLogHeader" Header="{loc:Loc Scan}"><ListView x:Name="VerifyWindowsFilesScanLogListView" Style="{StaticResource LogList}" SelectionMode="Single" KeyDown="LogListView_KeyDown" ><ListView.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc CopyLine}" Click="LogListView_CopyLine_Click"/><MenuItem Header="{loc:Loc CopyAll}" Click="LogListView_CopyAll_Click"/></ContextMenu></ListView.ContextMenu></ListView></TabItem>
<TabItem x:Name="VerifyWindowsFilesRepairLogHeader" Header="{loc:Loc Repair}"><ListView x:Name="VerifyWindowsFilesRepairLogListView" Style="{StaticResource LogList}" SelectionMode="Single" KeyDown="LogListView_KeyDown" ><ListView.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc CopyLine}" Click="LogListView_CopyLine_Click"/><MenuItem Header="{loc:Loc CopyAll}" Click="LogListView_CopyAll_Click"/></ContextMenu></ListView.ContextMenu></ListView></TabItem>
</TabControl></TabItem>
<TabItem x:Name="VerifyDeviceDriversLogHeader" Header="{loc:Loc DriversTab}"><TabControl>
<TabItem x:Name="VerifyDeviceDriversScanLogHeader" Header="{loc:Loc Scan}"><ListView x:Name="VerifyDeviceDriversScanLogListView" Style="{StaticResource LogList}" SelectionMode="Single" KeyDown="LogListView_KeyDown" ><ListView.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc CopyLine}" Click="LogListView_CopyLine_Click"/><MenuItem Header="{loc:Loc CopyAll}" Click="LogListView_CopyAll_Click"/></ContextMenu></ListView.ContextMenu></ListView></TabItem>

</TabControl></TabItem>
<TabItem x:Name="OptimizeDrivesLogHeader" Header="{loc:Loc MaintenanceTab}"><TabControl>
<TabItem x:Name="OptimizeDrivesScanLogHeader" Header="{loc:Loc Scan}"><ListView x:Name="OptimizeDrivesScanLogListView" Style="{StaticResource LogList}" SelectionMode="Single" KeyDown="LogListView_KeyDown" ><ListView.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc CopyLine}" Click="LogListView_CopyLine_Click"/><MenuItem Header="{loc:Loc CopyAll}" Click="LogListView_CopyAll_Click"/></ContextMenu></ListView.ContextMenu></ListView></TabItem>

</TabControl></TabItem>
</TabControl>
<Grid Grid.Row="2" Margin="0,10,0,0">
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <TextBlock x:Name="SessionStatus" Text="{loc:Loc SessionReady}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0"/>
 <TextBlock x:Name="SessionCount" Grid.Column="1" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" Margin="0,0,14,0"/>
 <TextBlock x:Name="ElapsedStatus" Grid.Column="2" Foreground="{DynamicResource MutedBrush}" FontFamily="Consolas"/>
</Grid>
</Grid>
</Window>
