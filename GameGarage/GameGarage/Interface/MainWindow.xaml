<Window x:Class="GameGarage.Interface.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:GameGarage.Resources"
 Title="{loc:Loc AppTitle}" Width="850" Height="620" MinWidth="720" MinHeight="440"
 Icon="/GameGarage;component/Resources/KindComputersIcon.ico" Loaded="Window_Loaded" Closing="Window_Closing"
 WindowStartupLocation="CenterScreen" Background="#F5F6F7">
<Window.Resources>
 <Style x:Key="ToolCell" TargetType="Border"><Setter Property="Margin" Value="0,0,0,2"/><Setter Property="Padding" Value="10,6"/><Setter Property="Background" Value="#EAF0F5"/></Style>
 <Style TargetType="CheckBox"><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></Setter.Value></Setter></Style>
 <Style TargetType="Button"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinWidth" Value="85"/></Style>
 <Style x:Key="LogList" TargetType="ListView">
  <Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/>
  <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
  <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True"/>

 </Style>
</Window.Resources>
<Window.TaskbarItemInfo><TaskbarItemInfo x:Name="TaskbarProgressBar" ProgressState="None"/></Window.TaskbarItemInfo>
<Grid Margin="16">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Image Source="/GameGarage;component/Resources/KindComputersIcon.ico" Width="40" Height="40" Margin="0,0,12,0"/>
 <StackPanel Grid.Column="1"><TextBlock Text="{loc:Loc AppTitle}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc Company}" Foreground="#475569"/></StackPanel>
</Grid>
<DockPanel Grid.Row="1" Margin="0,0,0,12">
 <Button x:Name="StartTuneUpButton" Content="{loc:Loc RunSelected}" Click="StartTuneUpButton_Click" FontWeight="SemiBold"/>
 <Button x:Name="CancelTuneUpButton" Content="{loc:Loc Cancel}" Click="CancelTuneUpButton_Click" Visibility="Collapsed"/>
 <Button Content="{loc:Loc Help}" Click="HelpHyperlink_Click" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
</DockPanel>
<TabControl Grid.Row="2">
 <TabItem Header="{loc:Loc Overview}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
 <TextBlock Text="{loc:Loc Tagline}" TextWrapping="Wrap" Margin="0,0,0,12"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock Grid.Column="0" Text="{loc:Loc Tool}" FontWeight="SemiBold" Margin="10,0,0,8"/><TextBlock Grid.Column="1" Text="{loc:Loc Status}" FontWeight="SemiBold" Margin="10,0,0,8"/><TextBlock Grid.Column="2" Text="{loc:Loc Progress}" FontWeight="SemiBold" Margin="10,0,0,8"/>
 <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ToolCell}"><CheckBox x:Name="VerifyStabilityCheckBox" Content="{loc:Loc Stability}" IsChecked="True" VerticalAlignment="Center" /></Border>
<Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ToolCell}"><Label x:Name="VerifyStabilityLabel" Content="{loc:Loc Ready}" VerticalAlignment="Center" /></Border>
<Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ToolCell}"><ProgressBar x:Name="VerifyStabilityProgressBar" Minimum="0" Maximum="100" Height="12" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc Stability}" /></Border>
<Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ToolCell}"><CheckBox x:Name="VerifyDrivesCheckBox" Content="{loc:Loc Drives}" IsChecked="True" VerticalAlignment="Center" /></Border>
<Border Grid.Row="2" Grid.Column="1" Style="{StaticResource ToolCell}"><Label x:Name="VerifyDrivesLabel" Content="{loc:Loc Ready}" VerticalAlignment="Center" /></Border>
<Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ToolCell}"><ProgressBar x:Name="VerifyDrivesProgressBar" Minimum="0" Maximum="100" Height="12" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc Drives}" /></Border>
<Border Grid.Row="3" Grid.Column="0" Style="{StaticResource ToolCell}"><CheckBox x:Name="VerifyWindowsArchiveCheckBox" Content="{loc:Loc WindowsImage}" IsChecked="True" VerticalAlignment="Center" /></Border>
<Border Grid.Row="3" Grid.Column="1" Style="{StaticResource ToolCell}"><Label x:Name="VerifyWindowsArchiveLabel" Content="{loc:Loc Ready}" VerticalAlignment="Center" /></Border>
<Border Grid.Row="3" Grid.Column="2" Style="{StaticResource ToolCell}"><ProgressBar x:Name="VerifyWindowsArchiveProgressBar" Minimum="0" Maximum="100" Height="12" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc WindowsImage}" /></Border>
<Border Grid.Row="4" Grid.Column="0" Style="{StaticResource ToolCell}"><CheckBox x:Name="VerifyWindowsFilesCheckBox" Content="{loc:Loc WindowsFiles}" IsChecked="True" VerticalAlignment="Center" /></Border>
<Border Grid.Row="4" Grid.Column="1" Style="{StaticResource ToolCell}"><Label x:Name="VerifyWindowsFilesLabel" Content="{loc:Loc Ready}" VerticalAlignment="Center" /></Border>
<Border Grid.Row="4" Grid.Column="2" Style="{StaticResource ToolCell}"><ProgressBar x:Name="VerifyWindowsFilesProgressBar" Minimum="0" Maximum="100" Height="12" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc WindowsFiles}" /></Border>
<Border Grid.Row="5" Grid.Column="0" Style="{StaticResource ToolCell}"><CheckBox x:Name="VerifyDeviceDriversCheckBox" Content="{loc:Loc Drivers}" IsChecked="True" VerticalAlignment="Center" /></Border>
<Border Grid.Row="5" Grid.Column="1" Style="{StaticResource ToolCell}"><Label x:Name="VerifyDeviceDriversLabel" Content="{loc:Loc Ready}" VerticalAlignment="Center" /></Border>
<Border Grid.Row="5" Grid.Column="2" Style="{StaticResource ToolCell}"><ProgressBar x:Name="VerifyDeviceDriversProgressBar" Minimum="0" Maximum="100" Height="12" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc Drivers}" /></Border>
<Border Grid.Row="6" Grid.Column="0" Style="{StaticResource ToolCell}"><CheckBox x:Name="OptimizeDrivesCheckBox" Content="{loc:Loc Optimize}" IsChecked="False" VerticalAlignment="Center" /></Border>
<Border Grid.Row="6" Grid.Column="1" Style="{StaticResource ToolCell}"><Label x:Name="OptimizeDrivesLabel" Content="{loc:Loc Ready}" VerticalAlignment="Center" /></Border>
<Border Grid.Row="6" Grid.Column="2" Style="{StaticResource ToolCell}"><ProgressBar x:Name="OptimizeDrivesProgressBar" Minimum="0" Maximum="100" Height="12" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc Optimize}" /></Border>
 </Grid>
 <Border x:Name="StabilityTestNotification" Visibility="Collapsed" Padding="10" Background="#FFF4CE" Margin="0,8,0,0"><TextBlock Text="{loc:Loc RamNotice}" TextWrapping="Wrap"/></Border>
 <TextBlock Text="{loc:Loc MaintenanceNotice}" TextWrapping="Wrap" Foreground="#475569" Margin="0,12,0,0"/>
 </StackPanel></ScrollViewer></TabItem>
 <TabItem x:Name="VerifyStabilityLogHeader" Header="{loc:Loc RamTab}"><TabControl>
<TabItem x:Name="VerifyStabilityScanLogHeader" Header="{loc:Loc Scan}"><ListView x:Name="VerifyStabilityScanLogListView" Style="{StaticResource LogList}" SelectionMode="Single" KeyDown="LogListView_KeyDown" ><ListView.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc CopyLine}" Click="LogListView_CopyLine_Click"/><MenuItem Header="{loc:Loc CopyAll}" Click="LogListView_CopyAll_Click"/></ContextMenu></ListView.ContextMenu></ListView></TabItem>

</TabControl></TabItem>
<TabItem x:Name="VerifyDrivesLogHeader" Header="{loc:Loc DrivesTab}"><TabControl>
<TabItem x:Name="VerifyDrivesScanLogHeader" Header="{loc:Loc Scan}"><ListView x:Name="VerifyDrivesScanLogListView" Style="{StaticResource LogList}" SelectionMode="Single" KeyDown="LogListView_KeyDown" ><ListView.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc CopyLine}" Click="LogListView_CopyLine_Click"/><MenuItem Header="{loc:Loc CopyAll}" Click="LogListView_CopyAll_Click"/></ContextMenu></ListView.ContextMenu></ListView></TabItem>
<TabItem x:Name="VerifyDrivesRepairLogHeader" Header="{loc:Loc Repair}"><ListView x:Name="VerifyDrivesRepairLogListView" Style="{StaticResource LogList}" SelectionMode="Single" KeyDown="LogListView_KeyDown" ><ListView.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc CopyLine}" Click="LogListView_CopyLine_Click"/><MenuItem Header="{loc:Loc CopyAll}" Click="LogListView_CopyAll_Click"/></ContextMenu></ListView.ContextMenu></ListView></TabItem>
</TabControl></TabItem>
<TabItem x:Name="VerifyWindowsArchiveLogHeader" Header="{loc:Loc ImageTab}"><TabControl>
<TabItem x:Name="VerifyWindowsArchiveScanLogHeader" Header="{loc:Loc Scan}"><ListView x:Name="VerifyWindowsArchiveScanLogListView" Style="{StaticResource LogList}" SelectionMode="Single" KeyDown="LogListView_KeyDown" ><ListView.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc CopyLine}" Click="LogListView_CopyLine_Click"/><MenuItem Header="{loc:Loc CopyAll}" Click="LogListView_CopyAll_Click"/></ContextMenu></ListView.ContextMenu></ListView></TabItem>
<TabItem x:Name="VerifyWindowsArchiveRepairLogHeader" Header="{loc:Loc Repair}"><ListView x:Name="VerifyWindowsArchiveRepairLogListView" Style="{StaticResource LogList}" SelectionMode="Single" KeyDown="LogListView_KeyDown" ><ListView.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc CopyLine}" Click="LogListView_CopyLine_Click"/><MenuItem Header="{loc:Loc CopyAll}" Click="LogListView_CopyAll_Click"/></ContextMenu></ListView.ContextMenu></ListView></TabItem>
</TabControl></TabItem>
<TabItem x:Name="VerifyWindowsFilesLogHeader" Header="{loc:Loc FilesTab}"><TabControl>
<TabItem x:Name="VerifyWindowsFilesScanLogHeader" Header="{loc:Loc Scan}"><ListView x:Name="VerifyWindowsFilesScanLogListView" Style="{StaticResource LogList}" SelectionMode="Single" KeyDown="LogListView_KeyDown" ><ListView.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc CopyLine}" Click="LogListView_CopyLine_Click"/><MenuItem Header="{loc:Loc CopyAll}" Click="LogListView_CopyAll_Click"/></ContextMenu></ListView.ContextMenu></ListView></TabItem>
<TabItem x:Name="VerifyWindowsFilesRepairLogHeader" Header="{loc:Loc Repair}"><ListView x:Name="VerifyWindowsFilesRepairLogListView" Style="{StaticResource LogList}" SelectionMode="Single" KeyDown="LogListView_KeyDown" ><ListView.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc CopyLine}" Click="LogListView_CopyLine_Click"/><MenuItem Header="{loc:Loc CopyAll}" Click="LogListView_CopyAll_Click"/></ContextMenu></ListView.ContextMenu></ListView></TabItem>
</TabControl></TabItem>
<TabItem x:Name="VerifyDeviceDriversLogHeader" Header="{loc:Loc DriversTab}"><TabControl>
<TabItem x:Name="VerifyDeviceDriversScanLogHeader" Header="{loc:Loc Scan}"><ListView x:Name="VerifyDeviceDriversScanLogListView" Style="{StaticResource LogList}" SelectionMode="Single" KeyDown="LogListView_KeyDown" ><ListView.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc CopyLine}" Click="LogListView_CopyLine_Click"/><MenuItem Header="{loc:Loc CopyAll}" Click="LogListView_CopyAll_Click"/></ContextMenu></ListView.ContextMenu></ListView></TabItem>

</TabControl></TabItem>
<TabItem x:Name="OptimizeDrivesLogHeader" Header="{loc:Loc MaintenanceTab}"><TabControl>
<TabItem x:Name="OptimizeDrivesScanLogHeader" Header="{loc:Loc Scan}"><ListView x:Name="OptimizeDrivesScanLogListView" Style="{StaticResource LogList}" SelectionMode="Single" KeyDown="LogListView_KeyDown" ><ListView.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc CopyLine}" Click="LogListView_CopyLine_Click"/><MenuItem Header="{loc:Loc CopyAll}" Click="LogListView_CopyAll_Click"/></ContextMenu></ListView.ContextMenu></ListView></TabItem>

</TabControl></TabItem>
</TabControl>
<Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock x:Name="SessionStatus" Text="{loc:Loc SessionReady}" TextWrapping="Wrap" Margin="0,0,12,0"/>
<TextBlock x:Name="ElapsedStatus" Grid.Column="1"/>
</Grid>
</Grid>
</Window>
