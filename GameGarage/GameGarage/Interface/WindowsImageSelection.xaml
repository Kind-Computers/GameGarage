<Window x:Class="GameGarage.Interface.WindowsImageSelection"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:GameGarage.Resources" Title="{loc:Loc WindowsImageTitle}" Width="760" Height="530" MinWidth="600" MinHeight="400"
 WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closing="Window_Closing">
<Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="{loc:Loc ImagePrompt}" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBlock x:Name="CurrentWindowsVersionTextBox" FontWeight="SemiBold" Margin="0,0,0,12"/></StackPanel>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <TextBox x:Name="WindowsImageFileTextBox" TextChanged="WindowsImageFileTextBox_TextChanged" VerticalContentAlignment="Center" MinHeight="30" AutomationProperties.Name="{loc:Loc ImageFile}"/>
  <Button x:Name="BrowseButton" Grid.Column="1" Content="{loc:Loc Browse}" Click="BrowseButton_Click" Margin="8,0,0,0" Padding="12,6"/>
 </Grid>
 <TextBlock x:Name="ImageStatus" Grid.Row="2" Text="{loc:Loc AvailableImages}" TextWrapping="Wrap" Margin="0,12"/>
 <ListView Grid.Row="3" x:Name="AvailableImagesListView" ItemsSource="{Binding WindowsImages}" SelectionChanged="AvailableImagesListView_SelectionChanged">
  <ListView.View><GridView><GridViewColumn Header="{loc:Loc ImageIndex}" DisplayMemberBinding="{Binding Index}" Width="55"/><GridViewColumn Header="{loc:Loc ImageName}" DisplayMemberBinding="{Binding Name}" Width="230"/><GridViewColumn Header="{loc:Loc ImageDescription}" DisplayMemberBinding="{Binding Description}" Width="240"/><GridViewColumn Header="{loc:Loc ImageSize}" DisplayMemberBinding="{Binding Size}" Width="100"/></GridView></ListView.View>
  <ListView.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc CopyLine}" Click="AvailableImagesListView_CopyItem_Click"/><MenuItem Header="{loc:Loc CopyAll}" Click="AvailableImagesListView_CopyAll_Click"/></ContextMenu></ListView.ContextMenu>
 </ListView>
 <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
  <Button x:Name="OkButton" Content="{loc:Loc Select}" Click="OkButton_Click" IsEnabled="False" IsDefault="True" Padding="16,6" Margin="0,0,8,0"/>
  <Button Content="{loc:Loc Cancel}" Click="CancelButton_Click" IsCancel="True" Padding="16,6"/>
 </StackPanel>
</Grid></Window>
